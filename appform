          "中身を開けて確認する",
          "すぐに施設外へ運び出す",
          "その場を離れて次の巡回箇所へ進む"
        ],
        "answer": 0,
        "explanation": "答えは「触れずにその場を確保し、防災センター等へ報告する」。\n\n【覚え方】不審物は「さわらない・動かさない・近づけない・報告する」。中身を開けたり運び出したりするのは、万一爆発物だった場合に非常に危険なので絶対にしません。まず人を近づけないように現場を守り、上位者や警察の指示を仰ぐのが正解です。『見なかったことにして通り過ぎる』のも、被害を防げないため誤りです。",
        "media": {
          "type": "none",
          "src": "",
          "caption": ""
        }
      }
    ]
  },
  {
    "meta": {
      "title": "施設警備業務検定1級",
      "version": 1,
      "updatedAt": "2026-07-09"
    },
    "questions": []
  },
  {
    "meta": {
      "title": "交通誘導警備業務検定2級",
      "version": 1,
      "updatedAt": "2026-07-09"
    },
    "questions": []
  }
];

/* ====================== 状態 ====================== */
let data = EXAMS[0];          // 現在選択中の検定データ
let selectedCat = "__all__";   // 選択中カテゴリ
let queue = [];                // 出題キュー（問題の配列）
let idx = 0;                   // 現在の問題番号
let results = [];              // {q, correct} の配列
let answered = false;
let sessionStreak = 0;         // このセッションの連続正解数
let sessionUnlocks = [];       // このセッションで解放した実績

/* ====================== 学習記録（端末に保存） ======================
   端末のブラウザ内（localStorage）に保存するので、アプリを閉じても実績が残る。
   保存できない環境（プライベートモード等）ではメモリ上だけで動く。 */
const STORE_KEY = "keibi_progress_v1";
const defaultProgress = () => ({
  mastered: {},      // 正解したことのある問題ID { "q0001": true, ... }
  totalAnswered: 0,  // 累計 回答数
  totalCorrect: 0,   // 累計 正解数
  bestStreak: 0,     // 最高連続正解数
  perfectRuns: 0,    // 満点セッションの回数
  unlocked: {}       // 解放済み実績ID { "first": true, ... }
});
let progress = loadProgress();

function loadProgress() {
  try {
    const raw = localStorage.getItem(STORE_KEY);
    if (raw) return Object.assign(defaultProgress(), JSON.parse(raw));
  } catch (e) { /* 保存不可の環境では既定値で続行 */ }
  return defaultProgress();
}
function saveProgress() {
  try { localStorage.setItem(STORE_KEY, JSON.stringify(progress)); }
  catch (e) { /* 保存できなくてもアプリは動く */ }
}

/* --- 実績の定義 ---
   check(p): 解放条件を満たすか / progressText(p): 「3/10」などの進捗表示 */
const ALL_QUESTION_IDS = () => EXAMS.flatMap(e => e.questions.map(q => q.id));
const ACHIEVEMENTS = [
  { id: "first", icon: "🔰", name: "はじめの一歩", desc: "問題に1問チャレンジする",
    check: p => p.totalAnswered >= 1,
    progressText: p => `${Math.min(p.totalAnswered,1)}/1` },
  { id: "correct10", icon: "✅", name: "10問正解", desc: "累計で10問正解する",
    check: p => p.totalCorrect >= 10,
    progressText: p => `${Math.min(p.totalCorrect,10)}/10` },
  { id: "streak5", icon: "🔥", name: "5問連続正解", desc: "1回の学習で5問連続で正解する",
    check: p => p.bestStreak >= 5,
    progressText: p => `${Math.min(p.bestStreak,5)}/5` },
  { id: "perfect", icon: "💯", name: "満点達成", desc: "1回の学習をすべて正解で終える",
    check: p => p.perfectRuns >= 1,
    progressText: p => `${Math.min(p.perfectRuns,1)}/1` },
  { id: "master25", icon: "📚", name: "25問マスター", desc: "違う問題を25問、正解する",
    check: p => Object.keys(p.mastered).length >= 25,
    progressText: p => `${Math.min(Object.keys(p.mastered).length,25)}/25` },
  { id: "allclear", icon: "🏆", name: "全問制覇", desc: "登録されている全ての問題を正解する",
    check: p => { const ids = ALL_QUESTION_IDS(); return ids.length > 0 && ids.every(id => p.mastered[id]); },
    progressText: p => { const ids = ALL_QUESTION_IDS();
      return `${ids.filter(id => p.mastered[id]).length}/${ids.length}`; } }
];

/* 1問回答するたびに記録を更新し、新しく解放された実績を返す */
function recordAnswer(q, isCorrect) {
  progress.totalAnswered++;
  if (isCorrect) {
    progress.totalCorrect++;
    progress.mastered[q.id] = true;
    sessionStreak++;
    if (sessionStreak > progress.bestStreak) progress.bestStreak = sessionStreak;
  } else {
    sessionStreak = 0;
  }
  const newly = refreshUnlocks();
  saveProgress();
  return newly;
}
/* セッション終了時（満点判定など）に呼ぶ */
function recordSessionEnd(isPerfect) {
  if (isPerfect) progress.perfectRuns++;
  const newly = refreshUnlocks();
  saveProgress();
  return newly;
}
/* 条件を満たした実績を解放し、今回新しく解放されたものの配列を返す */
function refreshUnlocks() {
  const newly = [];
  ACHIEVEMENTS.forEach(a => {
    if (!progress.unlocked[a.id] && a.check(progress)) {
      progress.unlocked[a.id] = true;
      newly.push(a);
    }
  });
  return newly;
}

/* ====================== 共通ユーティリティ ====================== */
const $ = (id) => document.getElementById(id);

/* --- 自作ダイアログ（confirm/alertの代替）---
   スマホのホーム画面起動（スタンドアロン）では標準のconfirm/alertが
   無反応になることがあるため、画面内モーダルで確実に動くようにする。 */
function showConfirm(message, onOk) {
  $("modalMsg").textContent = message;
  $("modalCancel").style.display = "block";
  $("modalOk").textContent = "OK";
  const overlay = $("modalOverlay");
  const cleanup = () => {
    overlay.classList.remove("show");
    $("modalOk").onclick = null;
    $("modalCancel").onclick = null;
  };
  $("modalOk").onclick = () => { cleanup(); if (onOk) onOk(); };
  $("modalCancel").onclick = cleanup;
  overlay.classList.add("show");
}
function showAlert(message, onClose) {
  $("modalMsg").textContent = message;
  $("modalCancel").style.display = "none";
  $("modalOk").textContent = "OK";
  const overlay = $("modalOverlay");
  $("modalOk").onclick = () => {
    overlay.classList.remove("show");
    $("modalOk").onclick = null;
    if (onClose) onClose();
  };
  overlay.classList.add("show");
}

const shuffle = (arr) => {
  const a = arr.slice();
  for (let i = a.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [a[i], a[j]] = [a[j], a[i]];
  }
  return a;
};
function show(screen) {
  ["screenExam", "screenAchievements", "screenHome", "screenQuiz", "screenResult"]
    .forEach(s => $(s).classList.add("hidden"));
  $(screen).classList.remove("hidden");
  window.scrollTo(0, 0);
}

/* ====================== 実績画面 ====================== */
function renderAchievements() {
  const unlockedCount = ACHIEVEMENTS.filter(a => progress.unlocked[a.id]).length;
  $("achSummary").textContent =
    `解放した実績：${unlockedCount} / ${ACHIEVEMENTS.length}　（正解した問題：${Object.keys(progress.mastered).length}問）`;
  $("achProgressBar").style.width = `${(unlockedCount / ACHIEVEMENTS.length) * 100}%`;

  const list = $("achList");
  list.innerHTML = "";
  ACHIEVEMENTS.forEach(a => {
    const on = !!progress.unlocked[a.id];
    const card = document.createElement("div");
    card.className = "ach-card " + (on ? "unlocked" : "locked");
    const pt = a.progressText(progress);
    const [cur, max] = pt.split("/").map(Number);
    card.innerHTML = `
      <div class="ach-icon">${on ? a.icon : "🔒"}</div>
      <div class="ach-body">
        <div class="ach-name">${a.name}</div>
        <div class="ach-desc">${a.desc}</div>
        ${on ? "" : `<div class="ach-mini-bar"><div style="width:${max?Math.min(100,cur/max*100):0}%"></div></div>`}
      </div>
      <div class="ach-state">${on ? "解放済み" : pt}</div>`;
    list.appendChild(card);
  });
}

/* ====================== 検定選択 ====================== */
function renderExamList() {
  const list = $("examList");
  list.innerHTML = "";
  EXAMS.forEach((exam, i) => {
    const count = exam.questions.length;
    const ready = count > 0;
    const b = document.createElement("button");
    b.className = "cat-btn";
    if (!ready) { b.style.opacity = ".6"; }
    b.innerHTML = `<span>${exam.meta.title}</span>` +
      (ready ? `<span class="count">${count}問 ›</span>`
             : `<span class="count">準備中</span>`);
    b.onclick = () => {
      if (!ready) { showAlert("この検定はまだ問題が登録されていません。"); return; }
      data = exam;
      selectedCat = "__all__";
      renderHome();
      show("screenHome");
    };
    list.appendChild(b);
  });
}

/* ====================== ホーム ====================== */
function categories() {
  const map = new Map();
  data.questions.forEach(q => map.set(q.category, (map.get(q.category) || 0) + 1));
  return map;
}
function renderHome() {
  $("appTitle").textContent = data.meta.title || "警備検定トレーニング";
  const list = $("catList");
  list.innerHTML = "";
  const addBtn = (key, label, count) => {
    const b = document.createElement("button");
    b.className = "cat-btn" + (selectedCat === key ? " selected" : "");
    b.innerHTML = `<span>${label}</span><span class="count">${count}問</span>`;
    b.onclick = () => { selectedCat = key; renderHome(); };
    list.appendChild(b);
  };
  addBtn("__all__", "すべての分野", data.questions.length);
  categories().forEach((count, cat) => addBtn(cat, cat, count));
  $("metaLine").textContent =
    `${data.meta.title || ""}（更新日: ${data.meta.updatedAt || "不明"} / 全${data.questions.length}問）`;
}

/* ====================== 出題 ====================== */
function startQuiz(questions) {
  queue = shuffle(questions);
  idx = 0;
  results = [];
  sessionStreak = 0;      // 連続正解はセッションごとにリセット
  sessionUnlocks = [];    // このセッションで解放した実績
  show("screenQuiz");
  renderQuestion();
}
function renderQuestion() {
  answered = false;
  const q = queue[idx];
  $("progText").textContent = `問題 ${idx + 1} / ${queue.length}`;
  $("progCat").textContent = "";
  $("progBar").style.width = `${(idx / queue.length) * 100}%`;
  $("qCat").textContent = q.category;
  $("qText").textContent = q.question;
  $("feedback").classList.add("hidden");

  const area = $("choiceArea");
  area.innerHTML = "";
  const correctText = q.choices[q.answer];
  shuffle(q.choices).forEach(text => {
    const b = document.createElement("button");
    b.className = "choice";
    b.textContent = text;
    b.onclick = () => answer(b, text === correctText, correctText, q);
    area.appendChild(b);
  });
}
function answer(btn, isCorrect, correctText, q) {
  if (answered) return;
  answered = true;
  results.push({ q, correct: isCorrect });

  // 学習記録を更新（新しく解放された実績があれば貯めておく）
  const newly = recordAnswer(q, isCorrect);
  newly.forEach(a => sessionUnlocks.push(a));

  document.querySelectorAll(".choice").forEach(c => {
    c.disabled = true;
    if (c.textContent === correctText) c.classList.add("correct");
    else if (c === btn && !isCorrect) c.classList.add("wrong");
    else c.classList.add("dim");
  });

  const v = $("verdict");
  if (isCorrect) {
    v.className = "verdict ok";
    v.innerHTML = '<span class="mark">○</span> 正解です';
    $("correctLine").textContent = "";
  } else {
    v.className = "verdict ng";
    v.innerHTML = '<span class="mark">×</span> 不正解';
    $("correctLine").textContent = `正解：${correctText}`;
  }
  $("expText").textContent = q.explanation || "（解説はありません）";
  renderMedia(q.media);
  $("btnNext").textContent = (idx + 1 >= queue.length) ? "結果を見る" : "次の問題へ";
  $("feedback").classList.remove("hidden");
  $("feedback").scrollIntoView({ behavior: "smooth", block: "start" });
}
function renderMedia(media) {
  const box = $("mediaBox");
  box.innerHTML = "";
  if (!media || media.type === "none" || !media.src) return;

  let el;
  if (media.type === "image") {
    el = document.createElement("img");
    el.src = media.src;
    el.alt = media.caption || "解説図";
  } else if (media.type === "video") {
    el = document.createElement("video");
    el.src = media.src;
    el.controls = true;
    el.playsInline = true;
    el.preload = "metadata";
    // URL参照動画は圏外だと再生できないため注意書きを出す
    if (/^https?:/.test(media.src)) {
      el.onerror = () => { note.style.display = "block"; };
    }
  }
  box.appendChild(el);
  if (media.caption) {
    const cap = document.createElement("p");
    cap.className = "media-cap";
    cap.textContent = media.caption;
    box.appendChild(cap);
  }
  const note = document.createElement("p");
  note.className = "offline-note";
  note.textContent = "※ この動画はインターネット接続時のみ再生できます";
  box.appendChild(note);
  if (media.type === "video" && /^https?:/.test(media.src) && !navigator.onLine) {
    note.style.display = "block";
  }
}

/* ====================== 結果 ====================== */
function renderResult() {
  const total = results.length;
  const good = results.filter(r => r.correct).length;
  const rate = total ? Math.round((good / total) * 100) : 0;
  $("scoreNum").textContent = good;
  $("scoreDen").textContent = ` / ${total}問（正答率 ${rate}%）`;
  $("scoreMsg").textContent =
    rate >= 90 ? "合格圏です。この調子で仕上げましょう。" :
    rate >= 70 ? "あと少し。間違えた問題を復習しましょう。" :
                 "まずは間違えた問題の解説をじっくり読みましょう。";

  // 分野別成績
  const byCat = new Map();
  results.forEach(r => {
    const c = byCat.get(r.q.category) || { good: 0, total: 0 };
    c.total++; if (r.correct) c.good++;
    byCat.set(r.q.category, c);
  });
  const el = $("catResult");
  el.innerHTML = "";
  byCat.forEach((v, cat) => {
    const row = document.createElement("div");
    row.className = "cat-row";
    row.innerHTML = `<span>${cat}</span><span>${v.good} / ${v.total}問</span>`;
    el.appendChild(row);
  });

  const wrong = results.filter(r => !r.correct).map(r => r.q);
  $("btnRetryWrong").classList.toggle("hidden", wrong.length === 0);
  $("btnRetryWrong").onclick = () => startQuiz(wrong);

  // 満点なら実績「満点達成」を判定し、解放分をまとめて表示
  const isPerfect = total > 0 && good === total;
  recordSessionEnd(isPerfect).forEach(a => sessionUnlocks.push(a));
  renderUnlockBanner(sessionUnlocks);

  show("screenResult");
}
function renderUnlockBanner(list) {
  const area = $("unlockArea");
  area.innerHTML = "";
  if (!list || list.length === 0) return;
  // 重複を除く
  const seen = new Set();
  const uniq = list.filter(a => (seen.has(a.id) ? false : seen.add(a.id)));
  const banner = document.createElement("div");
  banner.className = "unlock-banner";
  banner.innerHTML = `<h3>🎉 新しい実績を解放しました！</h3>` +
    uniq.map(a => `<div class="unlock-item"><span class="ic">${a.icon}</span><span>${a.name}</span></div>`).join("");
  area.appendChild(banner);
}

/* ====================== イベント ====================== */
$("btnBackToExam").onclick = () => { renderExamList(); show("screenExam"); };
$("btnStart").onclick = () => {
  const qs = selectedCat === "__all__"
    ? data.questions
    : data.questions.filter(q => q.category === selectedCat);
  if (qs.length === 0) { showAlert("この分野には問題がありません。"); return; }
  startQuiz(qs);
};
$("btnNext").onclick = () => {
  idx++;
  if (idx >= queue.length) renderResult();
  else { renderQuestion(); window.scrollTo(0, 0); }
};
$("btnQuit").onclick = () => {
  showConfirm("学習を中断して分野の選択に戻りますか？\n（この回の成績は保存されません）", () => show("screenHome"));
};
$("btnHome").onclick = () => show("screenHome");

// 実績画面への遷移
$("btnAchievements").onclick = () => { renderAchievements(); show("screenAchievements"); };
$("btnViewAch").onclick = () => { renderAchievements(); show("screenAchievements"); };
$("btnBackFromAch").onclick = () => { renderExamList(); show("screenExam"); };
$("btnResetProgress").onclick = () => {
  showConfirm("学習の記録と実績をすべて消去します。よろしいですか？\n（元に戻せません）", () => {
    progress = defaultProgress();
    saveProgress();
    renderAchievements();
  });
};

/* ====================== 初期表示 ====================== */
renderExamList();
show("screenExam");
</script>
