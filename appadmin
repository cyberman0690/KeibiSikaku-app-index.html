<script>
"use strict";
/* =====================================================================
   問題編集ツール
   - 複数の検定（2級／1級／交通誘導 など）を管理できる
   - 「index.html を書き出す」で、学習アプリ本体に問題を埋め込んだ
     完成版HTMLを生成する（＝GitHubにアップすればそのまま公開できる）
   - 「作業ファイル(JSON)」は、あとで編集を再開するための保存用
   ===================================================================== */

/* ---------- 初期データ（現在アプリに入っている内容） ---------- */
let exams = INITIAL_EXAMS;   // ページ下部で読み込む
let examIdx = 0;             // 編集中の検定
let currentId = null;        // 編集中の問題ID（null = 新規）
let mediaState = { type: "none", src: "", caption: "" };

const MAX_VIDEO_MB = 10;
const IMG_MAX_EDGE = 800;

/* ---------- ユーティリティ ---------- */
const $ = (id) => document.getElementById(id);
const today = () => new Date().toISOString().slice(0, 10);
const esc = (s) => { const d = document.createElement("div"); d.textContent = s ?? ""; return d.innerHTML; };
const curExam = () => exams[examIdx];

/* IDは検定ごとに連番。全体で重複しないよう検定番号を接頭辞に含める */
function nextId() {
  const all = exams.flatMap(e => e.questions.map(q => q.id));
  let n = 0;
  all.forEach(id => { const m = /(\d+)$/.exec(id || ""); if (m) n = Math.max(n, parseInt(m[1], 10)); });
  return "q" + String(n + 1).padStart(4, "0");
}

/* ---------- 検定タブ ---------- */
function renderExamTabs() {
  const wrap = $("examTabs");
  wrap.innerHTML = "";
  exams.forEach((e, i) => {
    const b = document.createElement("button");
    b.className = "exam-tab" + (i === examIdx ? " active" : "");
    b.innerHTML = `${esc(e.meta.title)}<span class="n">${e.questions.length}問</span>`;
    b.onclick = () => { examIdx = i; currentId = null; clearForm(); renderAll(); };
    wrap.appendChild(b);
  });
}
$("btnAddExam").onclick = () => {
  const name = prompt("追加する検定の名前を入力してください。\n例：雑踏警備業務検定2級");
  if (!name || !name.trim()) return;
  exams.push({ meta: { title: name.trim(), version: 1, updatedAt: today() }, questions: [] });
  examIdx = exams.length - 1;
  clearForm();
  renderAll();
};
$("btnRenameExam").onclick = () => {
  const name = prompt("検定の名前を変更します。", curExam().meta.title);
  if (!name || !name.trim()) return;
  curExam().meta.title = name.trim();
  renderAll();
};
$("btnDeleteExam").onclick = () => {
  if (exams.length <= 1) { alert("最後の1つは削除できません。"); return; }
  if (!confirm(`「${curExam().meta.title}」を、含まれる${curExam().questions.length}問ごと削除します。よろしいですか？`)) return;
  exams.splice(examIdx, 1);
  examIdx = 0;
  clearForm();
  renderAll();
};

/* ---------- 問題一覧 ---------- */
function renderList() {
  const filter = $("catFilter").value;
  const list = $("qList");
  list.innerHTML = "";
  const qs = curExam().questions.filter(q => filter === "__all__" || q.category === filter);
  if (qs.length === 0) {
    list.innerHTML = '<p class="empty-note">問題がありません。<br>「＋ 新規」から追加してください。</p>';
  }
  qs.forEach(q => {
    const div = document.createElement("div");
    div.className = "q-item" + (q.id === currentId ? " active" : "");
    const flag = q.media && q.media.type !== "none"
      ? `<span class="media-flag">📎 ${q.media.type === "image" ? "画像" : "動画"}</span>` : "";
    div.innerHTML = `<span class="cat">${esc(q.category)}</span> ${flag}<p class="txt">${esc(q.question)}</p>`;
    div.onclick = () => loadToForm(q.id);
    list.appendChild(div);
  });
  renderCatOptions();
}
function renderCatOptions() {
  const cats = [...new Set(curExam().questions.map(q => q.category))];
  const sel = $("catFilter");
  const cur = sel.value;
  sel.innerHTML = '<option value="__all__">すべての分野</option>' +
    cats.map(c => `<option value="${esc(c)}">${esc(c)}</option>`).join("");
  if ([...sel.options].some(o => o.value === cur)) sel.value = cur;
  $("catOptions").innerHTML = cats.map(c => `<option value="${esc(c)}">`).join("");
}
$("catFilter").onchange = renderList;

function renderAll() {
  renderExamTabs();
  renderList();
  $("editingExam").textContent = `編集中の検定：${curExam().meta.title}`;
}

/* ---------- フォーム ---------- */
function buildChoiceRows() {
  const wrap = $("choiceRows");
  wrap.innerHTML = "";
  for (let i = 0; i < 4; i++) {
    const row = document.createElement("div");
    row.className = "choice-row";
    row.innerHTML = `
      <input type="radio" name="correct" value="${i}" id="r${i}" ${i === 0 ? "checked" : ""}>
      <span class="num">${i + 1}</span>
      <input type="text" class="choice-input" id="c${i}" placeholder="選択肢 ${i + 1}">`;
    wrap.appendChild(row);
  }
}
function clearForm() {
  currentId = null;
  $("formTitle").textContent = "新しい問題の作成";
  $("fCat").value = ""; $("fQuestion").value = ""; $("fExp").value = "";
  for (let i = 0; i < 4; i++) $("c" + i).value = "";
  document.querySelector('input[name=correct][value="0"]').checked = true;
  setMedia({ type: "none", src: "", caption: "" });
  $("saveMsg").textContent = "";
}
function loadToForm(id) {
  const q = curExam().questions.find(x => x.id === id);
  if (!q) return;
  currentId = id;
  $("formTitle").textContent = `問題の編集（${id}）`;
  $("fCat").value = q.category;
  $("fQuestion").value = q.question;
  $("fExp").value = q.explanation || "";
  for (let i = 0; i < 4; i++) $("c" + i).value = q.choices[i] ?? "";
  document.querySelector(`input[name=correct][value="${q.answer}"]`).checked = true;
  setMedia(q.media || { type: "none", src: "", caption: "" });
  $("saveMsg").textContent = "";
  renderList();
}
function readForm() {
  return {
    id: currentId || nextId(),
    category: $("fCat").value.trim() || "未分類",
    question: $("fQuestion").value.trim(),
    choices: [0, 1, 2, 3].map(i => $("c" + i).value.trim()),
    answer: parseInt(document.querySelector("input[name=correct]:checked").value, 10),
    explanation: $("fExp").value.trim(),
    media: { ...mediaState, caption: $("mediaCaption").value.trim() }
  };
}
function validateForm(q) {
  if (!q.question) return "問題文を入力してください。";
  if (q.choices.some(c => !c)) return "選択肢は4つすべて入力してください。";
  if (new Set(q.choices).size !== 4) return "選択肢に同じ文が含まれています。";
  return null;
}

/* ---------- メディア ---------- */
function setMedia(m) {
  mediaState = { type: m.type || "none", src: m.src || "", caption: m.caption || "" };
  $("fMediaType").value = mediaState.type;
  $("mediaUrl").value = /^https?:/.test(mediaState.src) ? mediaState.src : "";
  $("mediaCaption").value = mediaState.caption;
  $("mediaControls").classList.toggle("hidden", mediaState.type === "none");
  $("mediaFile").accept = mediaState.type === "image" ? "image/*" : "video/*";
  $("mediaHint").textContent = mediaState.type === "image"
    ? "画像は自動で縮小してファイル内に埋め込みます（圏外でも表示できます）。"
    : `動画ファイルは${MAX_VIDEO_MB}MBまで埋め込めます。長い動画はURL指定を推奨（URL動画はオンライン時のみ再生）。`;
  $("sizeWarn").style.display = "none";
  renderMediaPreview();
}
function renderMediaPreview() {
  const box = $("mediaPreview");
  box.innerHTML = "";
  if (mediaState.type === "none" || !mediaState.src) return;
  const el = mediaState.type === "image"
    ? Object.assign(document.createElement("img"), { src: mediaState.src })
    : Object.assign(document.createElement("video"), { src: mediaState.src, controls: true });
  box.appendChild(el);
}
$("fMediaType").onchange = () => setMedia({ type: $("fMediaType").value, src: "", caption: $("mediaCaption").value });
$("mediaUrl").onchange = () => { const u = $("mediaUrl").value.trim(); if (u) { mediaState.src = u; renderMediaPreview(); } };
$("mediaFile").onchange = (e) => {
  const file = e.target.files[0];
  if (!file) return;
  if (mediaState.type === "image") embedImage(file); else embedVideo(file);
  e.target.value = "";
};
function embedImage(file) {
  const img = new Image();
  const reader = new FileReader();
  reader.onload = () => { img.src = reader.result; };
  img.onload = () => {
    const scale = Math.min(1, IMG_MAX_EDGE / Math.max(img.width, img.height));
    const canvas = document.createElement("canvas");
    canvas.width = Math.round(img.width * scale);
    canvas.height = Math.round(img.height * scale);
    canvas.getContext("2d").drawImage(img, 0, 0, canvas.width, canvas.height);
    mediaState.src = canvas.toDataURL("image/jpeg", 0.82);
    renderMediaPreview();
  };
  reader.readAsDataURL(file);
}
function embedVideo(file) {
  const mb = file.size / (1024 * 1024);
  if (mb > MAX_VIDEO_MB) {
    const w = $("sizeWarn");
    w.textContent = `この動画は ${mb.toFixed(1)}MB あります。埋め込み上限（${MAX_VIDEO_MB}MB）を超えるため、動画を短くするかURL指定をご利用ください。`;
    w.style.display = "block";
    return;
  }
  const reader = new FileReader();
  reader.onload = () => { mediaState.src = reader.result; renderMediaPreview(); };
  reader.readAsDataURL(file);
}

/* ---------- 保存・複製・削除 ---------- */
$("btnSave").onclick = () => {
  const q = readForm();
  const err = validateForm(q);
  if (err) { alert(err); return; }
  const arr = curExam().questions;
  const i = arr.findIndex(x => x.id === q.id);
  if (i >= 0) arr[i] = q; else arr.push(q);
  currentId = q.id;
  curExam().meta.updatedAt = today();
  renderAll();
  $("saveMsg").textContent = "✓ 保存しました";
};
$("btnDup").onclick = () => {
  const q = readForm();
  const err = validateForm(q);
  if (err) { alert(err); return; }
  q.id = nextId();
  curExam().questions.push(q);
  loadToForm(q.id);
  renderAll();
  $("saveMsg").textContent = "✓ 複製しました";
};
$("btnDelete").onclick = () => {
  if (!currentId) { alert("削除する問題が選択されていません。"); return; }
  if (!confirm("この問題を削除しますか？（元に戻せません）")) return;
  curExam().questions = curExam().questions.filter(q => q.id !== currentId);
  clearForm();
  renderAll();
};
$("btnNew").onclick = () => { clearForm(); renderList(); };

/* ---------- 書き出し：ファイルをダウンロードさせる共通処理 ---------- */
function download(filename, content, mime) {
  const blob = new Blob([content], { type: mime });
  const a = document.createElement("a");
  a.href = URL.createObjectURL(blob);
  a.download = filename;
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
  setTimeout(() => URL.revokeObjectURL(a.href), 1000);
}

/* ---------- ★ index.html の書き出し（GitHub公開用） ----------
   アプリ本体のテンプレートに、今の問題データを差し込んで完成版HTMLを作る。 */
$("btnExportApp").onclick = () => {
  const total = exams.reduce((s, e) => s + e.questions.length, 0);
  if (total === 0) { alert("問題が1問もありません。"); return; }

  // テンプレートを取り出す（HTMLを壊さないため </scr + ipt> を退避してあるので元に戻す）
  // ※ソース中に閉じscriptタグの文字列をそのまま書くとHTMLが途中で終わるため、分割して組み立てる
  const CLOSE_TAG = "<" + "/script>";
  const tpl = $("appTemplate").textContent.split("<\\/script>").join(CLOSE_TAG);

  // 問題データをJSONにしてテンプレートへ差し込む
  const dataJson = JSON.stringify(exams, null, 2);
  const html = tpl.replace("__EXAMS_DATA__", () => dataJson);

  // 差し込めたか安全確認
  if (html.includes("__EXAMS_DATA__")) { alert("書き出しに失敗しました（テンプレートの差し込み位置が見つかりません）。"); return; }

  download("index.html", html, "text/html;charset=utf-8");
  alert(`index.html を書き出しました（全${total}問）。\n\nこのファイルをGitHubのリポジトリにアップロードすれば公開できます。\n※ファイル名は index.html のまま変えないでください。`);
};

/* ---------- 作業ファイル（JSON）の保存・読み込み ---------- */
$("btnExportJson").onclick = () => {
  exams.forEach(e => e.meta.updatedAt = today());
  download("questions.json", JSON.stringify(exams, null, 2), "application/json");
};
$("btnImport").onclick = () => $("fileInput").click();
$("fileInput").onchange = (e) => {
  const file = e.target.files[0];
  if (!file) return;
  const reader = new FileReader();
  reader.onload = () => {
    try {
      let obj = JSON.parse(reader.result);
      // 旧形式（単一検定のオブジェクト）も読めるようにする
      if (!Array.isArray(obj)) {
        if (obj && Array.isArray(obj.questions)) obj = [obj];
        else throw new Error("形式が不正です");
      }
      obj.forEach(e => {
        if (!e.meta || !Array.isArray(e.questions)) throw new Error("形式が不正です");
      });
      exams = obj;
      examIdx = 0;
      clearForm();
      renderAll();
      const total = exams.reduce((s, e) => s + e.questions.length, 0);
      alert(`読み込みました（${exams.length}検定 / 全${total}問）。`);
    } catch (err) {
      alert("読み込めませんでした：ファイルの形式が正しくありません。");
    }
  };
  reader.readAsText(file);
  e.target.value = "";
};

/* ---------- プレビュー ---------- */
$("btnPreview").onclick = () => {
  const q = readForm();
  const err = validateForm(q);
  if (err) { alert(err); return; }
  let mediaHtml = "";
  if (q.media.type === "image" && q.media.src)
    mediaHtml = `<img src="${q.media.src}" alt="">`;
  if (q.media.type === "video" && q.media.src)
    mediaHtml = `<video src="${q.media.src}" controls playsinline></video>`;
  if (mediaHtml && q.media.caption)
    mediaHtml += `<p class="hint" style="text-align:center">${esc(q.media.caption)}</p>`;
  $("pvBody").innerHTML = `
    <p class="pv-q">${esc(q.question)}</p>
    ${q.choices.map((c, i) =>
      `<div class="pv-choice ${i === q.answer ? "correct" : ""}">${esc(c)}${i === q.answer ? "　←正解" : ""}</div>`).join("")}
    <div class="pv-exp"><strong>解説：</strong>${esc(q.explanation) || "（未入力）"}${mediaHtml}</div>`;
  $("pvDialog").showModal();
};
$("pvClose").onclick = () => $("pvDialog").close();

/* ---------- 初期化 ---------- */
buildChoiceRows();
renderAll();
clearForm();
</script>
</body>
</html>
