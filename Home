<div class="sunbar"></div>
<header>
  <h1>🗼 資格の塔</h1>
  <span class="tag">警備検定トレーニング</span>
</header>
 
<main id="mainArea">
 
  <!-- ========== 画面1: ログイン ========== -->
  <section id="screenLogin">
    <div class="card">
      <div class="tower-hero">
