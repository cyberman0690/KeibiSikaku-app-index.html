function enterExamSelect() {
  $("welcomeLine").textContent = state.adminMode
    ? "ようこそ、管理者さん。学習する検定を選んでください。"
    : "ようこそ、挑戦者！ 学習する検定を選んでください。";
  $("btnExamEditor").classList.toggle("hidden", !state.adminMode);
  renderExamList();
  show("screenExam");
}
function renderExamList() {
  const list = $("examList");
  list.innerHTML = "";
  state.exams.forEach((exam) => {
    const count = exam.questions.length;
    const ready = count > 0;
    const b = document.createElement("button");
    b.className = "cat-btn";
    if (!ready) b.style.opacity = ".6";
    b.innerHTML = `<span>${esc(exam.meta.title)}</span>` +
      (ready ? `<span class="count">${count}問 ›</span>` : `<span class="count">準備中</span>`);
    b.onclick = () => {
      if (!ready) { showAlert("この検定はまだ問題が登録されていません。"); return; }
      state.currentExam = exam;
      state.selectedCat = "__all__";
      renderHome();
      show("screenHome");
    };
    list.appendChild(b);
  });
}
function setupExamScreen() {
  $("btnExamEditor").onclick = () => { location.href = CONFIG.EDITOR_URL; };
  $("btnShowAchievements").onclick = () => { renderAchievements(); show("screenAchievements"); };
}
 
/* ============================================================
   6-3. 実績画面
   ============================================================ */
function renderAchievements() {
  const p = state.progress;
  const unlockedCount = ACHIEVEMENTS.filter(a => p.unlocked[a.id]).length;
  $("achSummary").textContent =
    `解放した実績：${unlockedCount} / ${ACHIEVEMENTS.length}　（正解した問題：${Object.keys(p.mastered).length}問）`;
  $("achProgressBar").style.width = `${(unlockedCount / ACHIEVEMENTS.length) * 100}%`;
  const list = $("achList");
  list.innerHTML = "";
  ACHIEVEMENTS.forEach(a => {
    const on = !!p.unlocked[a.id];
    const card = document.createElement("div");
    card.className = "ach-card " + (on ? "unlocked" : "locked");
    const pt = a.progressText(p);
    const [cur, max] = pt.split("/").map(Number);
    card.innerHTML = `
      <div class="ach-icon">${on ? a.icon : "🔒"}</div>
      <div class="ach-body">
        <div class="ach-name">${a.name}</div>
        <div class="ach-desc">${a.desc}</div>
        ${on ? "" : `<div class="ach-mini-bar"><div style="width:${max ? Math.min(100, cur / max * 100) : 0}%"></div></div>`}
      </div>
      <div class="ach-state">${on ? "解放済み" : pt}</div>`;
    list.appendChild(card);
  });
}
function setupAchievementsScreen() {
  $("btnAchBack").onclick = () => enterExamSelect();
  $("btnResultAch").onclick = () => { renderAchievements(); show("screenAchievements"); };
  $("btnResetProgress").onclick = () => {
    showConfirm("学習の記録と実績をすべて消去します。よろしいですか？\n（元に戻せません）", () => {
      state.progress = defaultProgress();
      saveProgress();
      renderAchievements();
    });
  };
}
 
/* ============================================================
   6-4. 分野選択画面（制限時間の設定を含む）
   ============================================================ */
function renderHome() {
  const exam = state.currentExam;
  const list = $("catList");
  list.innerHTML = "";
 
  const counts = new Map();
  exam.questions.forEach(q => counts.set(q.category, (counts.get(q.category) || 0) + 1));
 
  const addBtn = (key, label, count) => {
    const b = document.createElement("button");
    b.className = "cat-btn" + (state.selectedCat === key ? " selected" : "");
    b.innerHTML = `<span>${esc(label)}</span><span class="count">${count}問</span>`;
    b.onclick = () => { state.selectedCat = key; renderHome(); };
    list.appendChild(b);
  };
  addBtn("__all__", "すべての分野", exam.questions.length);
  counts.forEach((count, cat) => addBtn(cat, cat, count));
 
  $("metaLine").textContent =
    `${exam.meta.title}（更新日: ${exam.meta.updatedAt || "不明"} / 全${exam.questions.length}問）`;
}
function setupHomeScreen() {
  // 制限時間の選択肢をCONFIGから生成（選択肢を増やすときはCONFIGを直す）
  const sel = $("timeLimitSelect");
  sel.innerHTML = CONFIG.TIME_OPTIONS
    .map(o => `<option value="${o.minutes}">${esc(o.label)}</option>`).join("");
  sel.onchange = () => { state.timeLimitMin = parseInt(sel.value, 10); };
 
  $("btnBackToExam").onclick = () => enterExamSelect();
  $("btnStart").onclick = () => {
    const exam = state.currentExam;
    const qs = state.selectedCat === "__all__"
      ? exam.questions
      : exam.questions.filter(q => q.category === state.selectedCat);
    if (qs.length === 0) { showAlert("この分野には問題がありません。"); return; }
    startQuiz(qs);
  };
}
 
/* ============================================================
   6-5. 出題画面
   ============================================================ */
function startQuiz(questions) {
  state.quiz = { queue: shuffle(questions), idx: 0, results: [], answered: false, streak: 0, unlocks: [] };
  startTimer();          // 制限時間なし(0)なら何もしない
  show("screenQuiz");
  renderQuestion();
}
function renderQuestion() {
  const quiz = state.quiz;
  quiz.answered = false;
  const q = quiz.queue[quiz.idx];
  $("progText").textContent = `問題 ${quiz.idx + 1} / ${quiz.queue.length}`;
  $("progBar").style.width = `${(quiz.idx / quiz.queue.length) * 100}%`;
  $("qCat").textContent = q.category;
  $("qText").textContent = q.question;
  $("feedback").classList.add("hidden");
 
  const area = $("choiceArea");
  area.innerHTML = "";
  const correctText = q.choices[q.answer];
  shuffle(q.choices).forEach(text => {
    const b = document.createElement("button");
    b.className = "choice";
    b.textContent = text;
    b.onclick = () => answerQuestion(b, text === correctText, correctText, q);
    area.appendChild(b);
  });
}
function answerQuestion(btn, isCorrect, correctText, q) {
  const quiz = state.quiz;
  if (quiz.answered) return;
  quiz.answered = true;
  quiz.results.push({ q, correct: isCorrect });
  quiz.unlocks.push(...recordAnswer(q, isCorrect));
 
  document.querySelectorAll(".choice").forEach(c => {
    c.disabled = true;
    if (c.textContent === correctText) c.classList.add("correct");
    else if (c === btn && !isCorrect) c.classList.add("wrong");
    else c.classList.add("dim");
  });
 
  const v = $("verdict");
  if (isCorrect) {
    v.className = "verdict ok";
    v.innerHTML = '<span class="mark">○</span> 正解です';
    $("correctLine").textContent = "";
  } else {
    v.className = "verdict ng";
    v.innerHTML = '<span class="mark">×</span> 不正解';
    $("correctLine").textContent = `正解：${correctText}`;
  }
  $("expText").textContent = q.explanation || "（解説はありません）";
  renderMedia(q.media);
  $("btnNext").textContent = (quiz.idx + 1 >= quiz.queue.length) ? "結果を見る" : "次の問題へ";
  $("feedback").classList.remove("hidden");
  $("feedback").scrollIntoView({ behavior: "smooth", block: "start" });
}
function renderMedia(media) {
  const box = $("mediaBox");
  box.innerHTML = "";
  if (!media || media.type === "none" || !media.src) return;
  let el;
  if (media.type === "image") {
    el = document.createElement("img");
    el.src = media.src; el.alt = media.caption || "解説図";
  } else if (media.type === "video") {
    el = document.createElement("video");
    el.src = media.src; el.controls = true; el.playsInline = true; el.preload = "metadata";
  }
  box.appendChild(el);
  if (media.caption) {
    const cap = document.createElement("p");
    cap.className = "media-cap"; cap.textContent = media.caption;
    box.appendChild(cap);
  }
  const note = document.createElement("p");
  note.className = "offline-note";
  note.textContent = "※ この動画はインターネット接続時のみ再生できます";
  box.appendChild(note);
  if (media.type === "video" && /^https?:/.test(media.src)) {
    el.onerror = () => { note.style.display = "block"; };
    if (typeof navigator !== "undefined" && navigator.onLine === false) note.style.display = "block";
  }
}
function setupQuizScreen() {
  $("btnNext").onclick = () => {
    state.quiz.idx++;
    if (state.quiz.idx >= state.quiz.queue.length) renderResult();
    else { renderQuestion(); window.scrollTo(0, 0); }
  };
  $("btnQuit").onclick = () => {
    showConfirm("学習を中断して分野の選択に戻りますか？\n（この回の成績は保存されません）", () => {
      stopTimer();
      show("screenHome");
    });
  };
}
 
/* ============================================================
   6-6. 結果画面
   ============================================================ */
function renderResult() {
  stopTimer();
  const quiz = state.quiz;
  const total = quiz.results.length;
  const good = quiz.results.filter(r => r.correct).length;
  const rate = total ? Math.round((good / total) * 100) : 0;
  quiz.unlocks.push(...recordSessionEnd(total > 0 && good === total));
 
  $("scoreNum").textContent = good;
  $("scoreDen").textContent = ` / ${total}問（正答率 ${rate}%）`;
  $("scoreMsg").textContent =
    rate >= CONFIG.PASS_RATE  ? "合格圏です。この調子で塔を登りましょう！" :
    rate >= CONFIG.RETRY_RATE ? "あと少し。間違えた問題を復習しましょう。" :
                                "まずは間違えた問題の解説をじっくり読みましょう。";
 
  const byCat = new Map();
  quiz.results.forEach(r => {
    const c = byCat.get(r.q.category) || { good: 0, total: 0 };
    c.total++; if (r.correct) c.good++;
    byCat.set(r.q.category, c);
  });
  const el = $("catResult");
  el.innerHTML = "";
  byCat.forEach((v, cat) => {
    const row = document.createElement("div");
    row.className = "cat-row";
    row.innerHTML = `<span>${esc(cat)}</span><span>${v.good} / ${v.total}問</span>`;
    el.appendChild(row);
  });
 
  const uniq = [...new Map(quiz.unlocks.map(a => [a.id, a])).values()];
  $("unlockBanner").classList.toggle("hidden", uniq.length === 0);
  $("unlockList").innerHTML = uniq.map(a =>
    `<div class="unlock-item"><span class="ic">${a.icon}</span><span><strong>${a.name}</strong>　${a.desc}</span></div>`).join("");
 
  const wrong = quiz.results.filter(r => !r.correct).map(r => r.q);
  $("btnRetryWrong").classList.toggle("hidden", wrong.length === 0);
  $("btnRetryWrong").onclick = () => startQuiz(wrong);
  show("screenResult");
}
function setupResultScreen() {
  $("btnHome").onclick = () => show("screenHome");
}
 
/* ============================================================
   7. タイマー（制限時間）
   ============================================================ */
 
/** 残り秒数を「mm:ss」の形に変換する */
function formatTime(sec) {
  const m = Math.floor(sec / 60);
  const s = sec % 60;
  return `${m}:${String(s).padStart(2, "0")}`;
}
/** タイマー表示を更新する */
function renderTimer() {
  const disp = $("timerDisplay");
  if (state.timeLimitMin === 0) { disp.textContent = ""; return; }
  disp.textContent = `⏱ 残り ${formatTime(state.timer.remainingSec)}`;
  disp.classList.toggle("warning", state.timer.remainingSec <= CONFIG.TIMER_WARNING_SEC);
}
/** 制限時間のカウントダウンを開始する（0=制限なし、なら何もしない） */
function startTimer() {
  stopTimer();
  if (state.timeLimitMin === 0) { renderTimer(); return; }
  state.timer.remainingSec = state.timeLimitMin * 60;
  renderTimer();
  state.timer.intervalId = setInterval(() => {
    state.timer.remainingSec--;
    renderTimer();
    if (state.timer.remainingSec <= 0) onTimeUp();
  }, 1000);
}
/** タイマーを止める（画面遷移時に必ず呼ぶ） */
function stopTimer() {
  if (state.timer.intervalId !== null) {
    clearInterval(state.timer.intervalId);
    state.timer.intervalId = null;
  }
}
/** 時間切れ：それまでの回答で結果画面へ */
function onTimeUp() {
  stopTimer();
  showAlert("⏱ 時間切れです！\nここまでの回答で結果を表示します。", () => renderResult());
}
 
/* ============================================================
   起動処理
   ============================================================ */
async function init() {
  state.progress = loadProgress();
  state.exams = await loadExams();
  setupLoginScreen();
  setupExamScreen();
  setupAchievementsScreen();
  setupHomeScreen();
  setupQuizScreen();
  setupResultScreen();
  show("screenLogin");
}
init();
</script>
