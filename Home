      </div>
      <h2 class="tower-title">資格の塔</h2>
      <p class="tower-sub">一問ずつ、合格まで登っていこう。</p>
 
      <label class="f" for="loginEmail">メールアドレス（任意）</label>
      <input type="email" id="loginEmail" placeholder="例：guard@example.com" autocomplete="email">
 
      <button class="btn-main" id="btnChallenger" style="margin-top:18px">挑戦者</button>
      <button class="btn-sun hidden" id="btnLoginEditor">🛠 問題編集（管理者）</button>
      <p class="login-note">メールアドレスは端末の外に送信されません。<br>空欄のままでも「挑戦者」で始められます。</p>
    </div>
  </section>
 
  <!-- ========== 画面2: 検定選択 ========== -->
  <section id="screenExam" class="hidden">
    <div class="card">
      <p class="home-lead" id="welcomeLine">学習する検定を選んでください。</p>
      <div id="examList"></div>
      <button class="btn-sun hidden" id="btnExamEditor">🛠 問題編集（管理者）</button>
    </div>
    <button class="btn-sub" id="btnShowAchievements" style="background:#fff">🏅 実績を見る</button>
    <button class="btn-ghost" id="btnLogout">ログイン画面に戻る</button>
  </section>
 
  <!-- ========== 画面3: 実績 ========== -->
  <section id="screenAchievements" class="hidden">
    <div class="card">
      <p class="home-lead" style="margin-bottom:4px">🏅 実績</p>
      <p class="meta-line" id="achSummary" style="text-align:left"></p>
      <div class="ach-progress"><div id="achProgressBar"></div></div>
      <div id="achList"></div>
    </div>
    <button class="btn-sub" id="btnAchBack">検定の選択に戻る</button>
    <button class="btn-ghost" id="btnResetProgress">学習記録をリセットする</button>
  </section>
 
  <!-- ========== 画面4: 分野選択（制限時間の設定もここ） ========== -->
  <section id="screenHome" class="hidden">
    <div class="card">
      <button class="btn-ghost" id="btnBackToExam" style="text-align:left;padding-left:0;min-height:36px">‹ 検定の選択に戻る</button>
      <p class="home-lead">分野を選んで「学習をはじめる」を押してください。</p>
      <div id="catList"></div>
 
      <label class="f" for="timeLimitSelect">⏱ 制限時間</label>
      <select id="timeLimitSelect"></select>
      <p class="hint">本試験は20問60分（1問あたり3分）です。時間内に解く練習ができます。</p>
 
      <button class="btn-main" id="btnStart" style="margin-top:14px">学習をはじめる</button>
      <p class="meta-line" id="metaLine"></p>
    </div>
  </section>
 
  <!-- ========== 画面5: 出題 ========== -->
  <section id="screenQuiz" class="hidden">
    <div class="progress">
      <span id="progText"></span>
      <span class="timer" id="timerDisplay"></span>
    </div>
    <div class="bar"><div id="progBar"></div></div>
    <div class="card">
      <span class="q-cat" id="qCat"></span>
      <p class="q-text" id="qText"></p>
      <div id="choiceArea"></div>
    </div>
    <div class="card hidden" id="feedback">
      <div class="verdict" id="verdict"></div>
      <p id="correctLine" style="font-size:.95rem"></p>
      <p class="exp-label">解説</p>
      <p class="exp-text" id="expText"></p>
      <div class="media-box" id="mediaBox"></div>
      <button class="btn-main" id="btnNext" style="margin-top:18px">次の問題へ</button>
    </div>
    <button class="btn-sub" id="btnQuit" style="border-color:var(--line);color:var(--sub)">中断して分野の選択に戻る</button>
  </section>
 
  <!-- ========== 画面6: 結果 ========== -->
  <section id="screenResult" class="hidden">
    <div class="unlock-banner hidden" id="unlockBanner">
      <h3>🎉 新しい実績を解放しました！</h3>
      <div id="unlockList"></div>
    </div>
    <div class="card">
      <div class="score-big"><span class="num" id="scoreNum">0</span><span class="den" id="scoreDen">/0問</span></div>
      <p class="score-msg" id="scoreMsg"></p>
      <div id="catResult"></div>
    </div>
    <button class="btn-main hidden" id="btnRetryWrong">間違えた問題だけ復習する</button>
    <button class="btn-sub" id="btnResultAch">🏅 実績を見る</button>
    <button class="btn-sub" id="btnHome">分野の選択に戻る</button>
  </section>
</main>
 
<!-- 汎用モーダル（confirm / alert の代替。スマホでも確実に動く） -->
<div class="modal-overlay" id="modalOverlay">
  <div class="modal" role="dialog" aria-modal="true">
    <p class="modal-msg" id="modalMsg"></p>
    <div class="modal-actions">
      <button class="btn-main" id="modalOk">OK</button>
      <button class="btn-sub" id="modalCancel">キャンセル</button>
    </div>
  </div>
</div>
 
