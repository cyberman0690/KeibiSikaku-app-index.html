<script>
"use strict";
/* =====================================================================
   資格の塔 問題画面 (index.html)
   ---------------------------------------------------------------------
   構成（このファイルの読み方）:
     1. CONFIG   … 設定値。数値や選択肢を変えたいときはここだけ直す
     2. state    … アプリの状態。実行中に変化する変数はすべてここ
     3. データ読み込み … questions.json → 失敗時は埋め込みデータ
     4. 共通部品 … DOM取得・シャッフル・モーダル
     5. 学習記録・実績
     6. 各画面の処理 … ログイン → 検定選択 → 分野選択 → 出題 → 結果
     7. タイマー … 制限時間機能
   ---------------------------------------------------------------------
   変更履歴:
     v2.0 2026-07-13 画面分割・データ外部化・CONFIG/state導入・制限時間追加
     v1.0 2026-07-12 資格の塔 初版
   ===================================================================== */
 
/* ============================================================
   1. CONFIG: 設定値の一元管理（マジックナンバー禁止）
   ============================================================ */
const CONFIG = {
  DATA_URL: "questions.json",          // 問題データの場所（index.htmlと同じフォルダ）
  EDITOR_URL: "editor.html",           // 編集画面の場所
  STORE_KEY: "shikaku_tower_progress_v1",  // 学習記録の保存キー
  ADMIN_KEY: "3266780251-1987317601",          // 管理者メールのハッシュ（平文は置かない）
  TIMER_WARNING_SEC: 60,               // 残りこの秒数で赤色の警告表示
  TIME_OPTIONS: [                      // 制限時間の選択肢（分。0=なし）
    { label: "なし（じっくり解く）", minutes: 0 },
    { label: "5分",  minutes: 5 },
    { label: "10分", minutes: 10 },
    { label: "30分", minutes: 30 },
    { label: "60分（本試験と同じ）", minutes: 60 }
  ],
  PASS_RATE: 90,                       // 合格圏の正答率(%)
  RETRY_RATE: 70                       // 復習推奨の正答率(%)
};
 
/* ============================================================
   2. state: 実行中に変化する状態の一元管理
   ============================================================ */
const state = {
  exams: [],            // 全検定データ（起動時に読み込み）
  userEmail: "",        // ログイン中のメールアドレス
  adminMode: false,     // 管理者かどうか
  currentExam: null,    // 学習中の検定
  selectedCat: "__all__", // 選択中の分野
  timeLimitMin: 0,      // 制限時間（分。0=なし）
  quiz: {               // 出題セッションの状態
    queue: [],          //   出題する問題の配列
    idx: 0,             //   現在の問題番号
    results: [],        //   {q, correct} の記録
    answered: false,    //   現在の問題に回答済みか
    streak: 0,          //   連続正解数
    unlocks: []         //   このセッションで解放した実績
  },
  timer: {              // タイマーの状態
    remainingSec: 0,    //   残り秒数
    intervalId: null    //   setIntervalのID（停止に使う）
  },
  progress: null        // 学習記録（初期化時に読み込み）
};
 
/* ============================================================
   3. データ読み込み
   ============================================================ */
 
/** 問題データの形式チェック。問題があればエラー文字列、なければnullを返す */
function validateExams(data) {
  if (!Array.isArray(data) || data.length === 0) return "検定データが空です";
  for (const exam of data) {
    if (!exam.meta || !exam.meta.title || !Array.isArray(exam.questions)) return "検定の形式が不正です";
    for (const q of exam.questions) {
      if (typeof q.question !== "string" || !Array.isArray(q.choices) || q.choices.length !== 4)
        return `問題 ${q.id || "?"} の形式が不正です`;
      if (!(Number.isInteger(q.answer) && q.answer >= 0 && q.answer <= 3))
        return `問題 ${q.id || "?"} の正解指定が不正です`;
    }
  }
  return null;
}
 
/** 埋め込みフォールバックデータを読む */
function loadFallbackData() {
  return JSON.parse(document.getElementById("fallbackData").textContent);
}
 
/**
 * 問題データを読み込む。
 * ①questions.json を取得（公開サーバー上での通常ルート）
 * ②失敗したら埋め込みデータ（ファイル直接開き・オフライン時）
 */
async function loadExams() {
  try {
    const res = await fetch(CONFIG.DATA_URL + "?t=" + Date.now()); // キャッシュ回避
    if (!res.ok) throw new Error("HTTP " + res.status);
    const data = await res.json();
    const err = validateExams(data);
    if (err) throw new Error(err);
    return data;
  } catch (e) {
    return loadFallbackData();
  }
}
 
/* ============================================================
   4. 共通部品
   ============================================================ */
const $ = (id) => document.getElementById(id);
const esc = (s) => { const d = document.createElement("div"); d.textContent = s ?? ""; return d.innerHTML; };
 
/** 配列をシャッフルした新しい配列を返す（元の配列は変えない） */
function shuffle(arr) {
  const a = arr.slice();
  for (let i = a.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [a[i], a[j]] = [a[j], a[i]];
  }
  return a;
}
 
const SCREENS = ["screenLogin","screenExam","screenAchievements","screenHome","screenQuiz","screenResult"];
/** 指定した画面だけを表示する */
function show(screen) {
  SCREENS.forEach(s => $(s).classList.add("hidden"));
  $(screen).classList.remove("hidden");
  window.scrollTo(0, 0);
}
 
/** 確認ダイアログ（標準confirmはスマホのホーム画面起動で動かないため自作） */
function showConfirm(message, onOk) {
  $("modalMsg").textContent = message;
  $("modalCancel").style.display = "block";
  const overlay = $("modalOverlay");
  const cleanup = () => { overlay.classList.remove("show"); $("modalOk").onclick = null; $("modalCancel").onclick = null; };
  $("modalOk").onclick = () => { cleanup(); if (onOk) onOk(); };
  $("modalCancel").onclick = cleanup;
  overlay.classList.add("show");
}
/** 通知ダイアログ（標準alertの代替） */
function showAlert(message, onClose) {
  $("modalMsg").textContent = message;
  $("modalCancel").style.display = "none";
  const overlay = $("modalOverlay");
  $("modalOk").onclick = () => { overlay.classList.remove("show"); $("modalOk").onclick = null; if (onClose) onClose(); };
  overlay.classList.add("show");
}
 
/* ---- 管理者判定（メールは平文で持たずハッシュで照合） ---- */
function hashA(s){ let h = 5381; for (let i = 0; i < s.length; i++) h = ((h << 5) + h + s.charCodeAt(i)) >>> 0; return h; }
function hashB(s){ let h = 2166136261; for (let i = 0; i < s.length; i++) { h = (h ^ s.charCodeAt(i)) >>> 0; h = Math.imul(h, 16777619) >>> 0; } return h; }
/** 全角→半角・小文字化などメール表記の揺れを吸収する */
function normalizeEmail(s) {
  return (s || "")
    .replace(/[\uFF01-\uFF5E]/g, c => String.fromCharCode(c.charCodeAt(0) - 0xFEE0))
    .replace(/\s+/g, "")
    .toLowerCase();
}
function isAdminEmail(s) {
  const e = normalizeEmail(s);
  return e !== "" && (hashA(e) + "-" + hashB(e)) === CONFIG.ADMIN_KEY;
}
 
/* ============================================================
   5. 学習記録・実績
   ============================================================ */
function defaultProgress() {
  return { mastered: {}, totalAnswered: 0, totalCorrect: 0, bestStreak: 0, perfectRuns: 0, unlocked: {} };
}
/** 学習記録を端末から読み込む（保存できない環境ではメモリのみで動く） */
function loadProgress() {
  try {
    const raw = localStorage.getItem(CONFIG.STORE_KEY);
    if (raw) return Object.assign(defaultProgress(), JSON.parse(raw));
  } catch (e) { /* 保存不可の環境 */ }
  return defaultProgress();
}
function saveProgress() {
  try { localStorage.setItem(CONFIG.STORE_KEY, JSON.stringify(state.progress)); } catch (e) {}
}
 
const allQuestionIds = () => state.exams.flatMap(e => e.questions.map(q => q.id));
 
const ACHIEVEMENTS = [
  { id: "first",     icon: "🔰", name: "はじめの一歩", desc: "問題に1問チャレンジする",
    check: p => p.totalAnswered >= 1, progressText: p => `${Math.min(p.totalAnswered,1)}/1` },
  { id: "correct10", icon: "✅", name: "10問正解",     desc: "累計で10問正解する",
    check: p => p.totalCorrect >= 10, progressText: p => `${Math.min(p.totalCorrect,10)}/10` },
  { id: "streak5",   icon: "🔥", name: "5問連続正解", desc: "1回の学習で5問連続で正解する",
    check: p => p.bestStreak >= 5, progressText: p => `${Math.min(p.bestStreak,5)}/5` },
  { id: "perfect",   icon: "💯", name: "満点達成",     desc: "1回の学習をすべて正解で終える",
    check: p => p.perfectRuns >= 1, progressText: p => `${Math.min(p.perfectRuns,1)}/1` },
  { id: "master25",  icon: "📚", name: "25問マスター", desc: "違う問題を25問、正解する",
    check: p => Object.keys(p.mastered).length >= 25,
    progressText: p => `${Math.min(Object.keys(p.mastered).length,25)}/25` },
  { id: "allclear",  icon: "🏆", name: "塔の頂上へ",   desc: "登録されている全ての問題を正解する",
    check: p => { const ids = allQuestionIds(); return ids.length > 0 && ids.every(id => p.mastered[id]); },
    progressText: p => { const ids = allQuestionIds();
      return `${ids.filter(id => p.mastered[id]).length}/${ids.length}`; } }
];
 
/** 回答を記録し、新しく解放された実績の配列を返す */
function recordAnswer(q, isCorrect) {
  const p = state.progress;
  p.totalAnswered++;
  if (isCorrect) {
    p.totalCorrect++;
    p.mastered[q.id] = true;
    state.quiz.streak++;
    if (state.quiz.streak > p.bestStreak) p.bestStreak = state.quiz.streak;
  } else {
    state.quiz.streak = 0;
  }
  const newly = refreshUnlocks();
  saveProgress();
  return newly;
}
/** セッション終了を記録し、新しく解放された実績の配列を返す */
function recordSessionEnd(isPerfect) {
  if (isPerfect) state.progress.perfectRuns++;
  const newly = refreshUnlocks();
  saveProgress();
  return newly;
}
function refreshUnlocks() {
  const newly = [];
  ACHIEVEMENTS.forEach(a => {
    if (!state.progress.unlocked[a.id] && a.check(state.progress)) {
      state.progress.unlocked[a.id] = true;
      newly.push(a);
    }
  });
  return newly;
}
 
